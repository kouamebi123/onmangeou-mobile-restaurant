{
  "name": "onmangeou-mobile-restaurant",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "description": "OnMangeOu - application mobile restaurant",
  "license": "UNLICENSED",
  "author": "Emmanuel Kouame",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:go": "expo start --go --port 8083",
    "start:go:clear": "expo start --go --port 8083 --clear",
    "export:mobile": "expo export --platform ios --platform android",
    "update:preview": "npx eas-cli@23.2.0 update --branch preview --environment preview --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "5.2.1",
    "@tanstack/react-query": "5.90.16",
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-crypto": "15.0.9",
    "expo-device": "8.0.10",
    "expo-font": "14.0.12",
    "expo-image": "3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "8.0.12",
    "expo-network": "8.0.8",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.66.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "3.25.76",
    "zustand": "5.0.8",
    "expo-updates": "~29.0.20",
    "@expo/metro-runtime": "~6.1.2"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.18.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
